# Database
DATABASE_URL="file:./dev.db"

# Security & Tokens
PREVIEW_JWT_SECRET="change-me-to-a-secure-random-secret-key"
CRON_SECRET="change-me-to-a-secure-cron-secret-key"

# AI & Blueprint Generation (Google Gemini)
GEMINI_API_KEY=""
GEMINI_MODEL_BLUEPRINT="gemini-flash-latest" # Options: gemini-flash-latest, gemini-3.8-flash, gemini-4-argon

# GitHub Integration (Optional: increases API rate limits)
GITHUB_TOKEN=""

# Cloud Deployment Mode
# Options: "stub" (fast simulated local orchestration, no cloud credentials required)
#          "live" (executes real API calls against Render and Vercel)
DEPLOY_MODE="stub"

# Cloud Provider API Credentials (Required if DEPLOY_MODE="live")
RENDER_API_KEY=""
RENDER_OWNER_ID="" # Optional: auto-detected from Render API key if left blank
VERCEL_API_TOKEN=""
